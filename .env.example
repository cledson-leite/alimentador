# Supabase do Rigoni-contabil. Por padrão só o Supabase local é aceito.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Só para --producao: ref do projeto de produção (a URL precisa ser https://<ref>.supabase.co).
SUPABASE_PROD_PROJECT_REF=
# Só para --permitir-api (segunda leitura de data/número/CNPJ). Chave dedicada, com limite de gasto no painel.
ANTHROPIC_API_KEY=
